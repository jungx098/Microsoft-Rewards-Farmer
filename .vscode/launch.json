{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python Debugger: Current File",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal"
    },
    {
      "name": "Microsoft Rewards Farmer Debug",
      "type": "python",
      "request": "launch",
      "program": "m5farmer.py",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Microsoft Rewards Farmer Debug (visible browser)",
      "type": "python",
      "request": "launch",
      "program": "m5farmer.py",
      "args": [
        "-v"
      ],
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
